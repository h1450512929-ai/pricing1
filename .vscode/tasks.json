{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "自动更新 GitHub Pages",
            "type": "shell",
            "command": "./update-pages.sh",
            "args": [
                "自动保存更新 - ${fileBasename}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        }
    ]
}